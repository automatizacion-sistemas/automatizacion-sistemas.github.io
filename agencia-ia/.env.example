# ─────────────────────────────────────────────────────────────
#  MI AGENCIA IA · configuración local
#  1. Copia este archivo y renómbralo a:  .env   (en esta misma carpeta)
#  2. Pega tu clave donde dice ANTHROPIC_API_KEY
#  3. Reinicia la app (Ctrl+C y luego: npm run dev)
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Clave de la API de Claude: https://console.anthropic.com/settings/keys
# Empieza con "sk-ant-". Sin comillas ni espacios.
ANTHROPIC_API_KEY=

# Modelo de los agentes. Opciones: claude-opus-5-5 (recomendado),
# claude-sonnet-5-5 (la mitad de precio), claude-haiku-5-5 (el más barato).
AGENT_MODEL=claude-opus-5-5

# Profundidad de razonamiento: low | medium | high | xhigh | max
# Más alto = mejores respuestas en tareas difíciles, pero más lento y más caro.
AGENT_EFFORT=medium

# Puerto del servidor local (no cambiar salvo conflicto).
PORT=8787

# (Opcional) Ruta a tu propio FFmpeg. Si lo dejas vacío se usa el que instala "npm install".
FFMPEG_PATH=

# (Opcional) PIN fijo para entrar desde el celular con "npm run celular".
# Si lo dejas vacío, se genera uno nuevo cada vez y aparece en la ventana negra.
ACCESS_PIN=
